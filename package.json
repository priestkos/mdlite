{
  "name": "mdlite",
  "version": "0.1.0",
  "private": true,
  "description": "A calm, offline Markdown editor for Windows",
  "author": "PriestKos",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "npm run build && electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "test:gui": "playwright test",
    "icons": "node scripts/make-icons.mjs",
    "pack:win": "npm run build && node scripts/collect-notices.mjs && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-image": "3.35.0",
    "@tiptap/extension-table": "3.35.0",
    "@tiptap/extension-task-item": "3.35.0",
    "@tiptap/extension-task-list": "3.35.0",
    "@tiptap/markdown": "3.35.0",
    "@tiptap/starter-kit": "3.35.0",
    "marked": "17.0.6"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5",
    "vite": "8.3.8"
  },
  "build": {
    "appId": "com.priestkos.mdlite",
    "productName": "mdlite",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "notices",
        "to": "notices"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "mdlite-${version}-windows-x64.exe"
    }
  }
}
